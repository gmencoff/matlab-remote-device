{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File Windows",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/python",
            "python": "${workspaceFolder}/python/venv/Scripts/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python"
            }
        },
        {
          "name": "Python: Current File Mac",
          "type": "debugpy",
          "request": "launch",
          "program": "${file}",
          "console": "integratedTerminal",
          "cwd": "${workspaceFolder}/python",
          "python": "${workspaceFolder}/python/venv/bin/python",
          "env": {
              "PYTHONPATH": "${workspaceFolder}/python"
          }
      },
        {
            "name": "Python: Test RemotePluto",
            "type": "debugpy",
            "request": "launch",
            "module": "test.testRemotePluto",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
          "type": "node",
          "request": "launch",
          "name": "Debug wsserver",
          "program": "${workspaceFolder}/backend/wsserver/src/server.ts",
          "cwd": "${workspaceFolder}/backend/wsserver",
          "runtimeArgs": ["-r", "ts-node/register"],
          "skipFiles": ["<node_internals>/**"],
          "console": "integratedTerminal",
          "internalConsoleOptions": "neverOpen",
          "sourceMaps": true,
          "env": {
            "TS_NODE_FILES": "true",
            "TS_NODE_TRANSPILE_ONLY": "true"
          }
        }
    ]
}