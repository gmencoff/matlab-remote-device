{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/python",
            "python": "${workspaceFolder}/python/venv/Scripts/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python"
            }
        },
        {
            "name": "Python: Test RemotePluto",
            "type": "debugpy",
            "request": "launch",
            "module": "test.testRemotePluto",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}